---
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: className = '' } = Astro.props;
---
<!-- Botanical sunflower — 12 petals, smooth bezier, concentric seed-head rings -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <!-- 12 petals, 30° apart — wide teardrop bezier, tip at r≈39, base at r≈16 -->
  <g stroke-width="1.5">
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(0 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(30 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(60 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(90 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(120 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(150 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(180 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(210 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(240 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(270 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(300 50 50)"/>
    <path d="M50,34 C42,27 40,16 50,11 C60,16 58,27 50,34" transform="rotate(330 50 50)"/>
  </g>

  <!-- Seed head: outer disk ring -->
  <circle cx="50" cy="50" r="13" stroke-width="1.5"/>

  <!-- Seed head: concentric inner rings suggesting the spiral pattern -->
  <circle cx="50" cy="50" r="8.5" stroke-width="0.9" stroke-opacity="0.65"/>
  <circle cx="50" cy="50" r="4.5" stroke-width="0.9" stroke-opacity="0.65"/>

  <!-- Center dot -->
  <circle cx="50" cy="50" r="1.8" fill="currentColor" stroke="none"/>
</svg>
