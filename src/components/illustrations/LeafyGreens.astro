---
/* Linocut leafy greens bunch. Leaves ink = currentColor; tie fixed sunflower. */
interface Props { size?: number; class?: string; }
const { size = 64, class: className = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
  <!-- left leaf -->
  <path d="M24 46C14 42 8.6 32 10.4 20c8.6 2 14.8 8.8 16.6 18 .4 2.4-.2 5.6-3 8Z" fill="currentColor"/>
  <!-- center leaf, taller and a touch crooked -->
  <path d="M31 47c-3.4-12 -2-25 5-36 6 10.6 6.4 24 1.4 34.6-1.4 3-5.4 4.4-6.4 1.4Z" fill="currentColor"/>
  <!-- right leaf -->
  <path d="M40 46c-1.6-9.6 3-19.6 12-25.4 1.8 11.4-2.6 21.4-9.4 26.4-1.2.9-2.4.4-2.6-1Z" fill="currentColor"/>
  <!-- bunch tie -->
  <path d="M25 47.6c4.8-1.6 9.6-1.6 14.4 0 1.6.6 1.6 4.2 0 4.8-4.8 1.6-9.6 1.6-14.4 0-1.6-.6-1.6-4.2 0-4.8Z" fill="#f2c230"/>
  <!-- stem ends -->
  <path d="M28 53c.6 2 1.2 3.6 2.4 5.2M33 53.4c.2 1.8.2 3.6 0 5.4M38 53c-.6 2-1.4 3.8-2.6 5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
