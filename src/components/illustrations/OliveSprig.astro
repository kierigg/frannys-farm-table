---
/* Linocut olive sprig with oil drip. Ink = currentColor (set color: olive on parent). */
interface Props { size?: number; class?: string; }
const { size = 64, class: className = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
  <!-- stem, slightly bowed -->
  <path d="M14 50C22 41 33 28 48 13c1-1 2.6-.7 2 1C39 28 28 40 17 52c-1.4 1.4-4-.6-3-2Z" fill="currentColor"/>
  <!-- leaves, imperfect lancets -->
  <path d="M24 36c-5-1-9.4-5-10-11 6 .4 10.4 4.6 11.6 9.6.3 1-.6 1.6-1.6 1.4Z" fill="currentColor"/>
  <path d="M33 27c-1.4-5 .2-10.8 4.6-14.6 2.2 5.6.8 11.6-3 15.2-.7.7-1.4.3-1.6-.6Z" fill="currentColor"/>
  <path d="M40 31c4.8-1.8 10.4-.8 14.4 3-4.8 3.4-11 3.2-15-.6-.8-.8-.4-1.9.6-2.4Z" fill="currentColor"/>
  <!-- olives -->
  <ellipse cx="22" cy="25" rx="4.4" ry="5.4" transform="rotate(-18 22 25)" fill="currentColor"/>
  <ellipse cx="44" cy="40" rx="4.2" ry="5.2" transform="rotate(20 44 40)" fill="currentColor"/>
  <!-- oil drip -->
  <path d="M22 36c2.4 3.4 4 6 4 8.4 0 2.4-1.8 4-4 4s-4-1.6-4-4c0-2.4 1.6-5 4-8.4Z" fill="#f2c230"/>
</svg>
