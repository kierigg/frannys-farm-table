---
/* Linocut lemon. Leaf and pip detail ink = currentColor; body fixed sunflower yellow. */
interface Props { size?: number; class?: string; }
const { size = 64, class: className = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
  <!-- body with nubs, slightly uneven -->
  <path d="M12 38C10.6 28 18 19.6 29 18.4c8.6-1 16.6 2.6 20.4 9.4 1 1.8 3.4 2.4 3.6 4.6.2 2-2 2.8-2.8 4.6-3 7-10.4 11.4-19.6 10.6C20.6 46.8 13.2 44 12 38Z" fill="#f2c230"/>
  <!-- print-line segments -->
  <path d="M22 27c-2.8 2-4.6 4.6-5.2 8-.3 1.4 1.9 2 2.4.6 1-3 2.4-5.4 4.4-7.2 1-1-.4-2.2-1.6-1.4Z" fill="currentColor" opacity="0.85"/>
  <!-- leaf -->
  <path d="M30 14c-3.8-4.4-9.8-6.2-15.6-4.6 2.6 5.4 8.2 8.2 14 7.2 1.4-.2 2.6-1.4 1.6-2.6Z" fill="currentColor"/>
  <!-- stem nub -->
  <path d="M30 16.8c-.4-1.6-.2-3 .6-4.4.9 1.2 1.4 2.6 1.2 4.2-.2 1.2-1.6 1.2-1.8.2Z" fill="currentColor"/>
</svg>
