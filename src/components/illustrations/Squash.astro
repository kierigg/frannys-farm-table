---
/* Linocut butternut squash. Body fixed sunflower; stem and print lines ink = currentColor. */
interface Props { size?: number; class?: string; }
const { size = 64, class: className = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
  <!-- body: narrow neck, fat bottom, leaning slightly -->
  <path d="M27 13c4-1.4 7.6.6 8 4.4.4 3.4-.6 7.2.8 10.2 2.4 5 8 7.6 9 13.6 1.2 7.4-4.6 13.6-13.6 14C22.6 55.6 15 50.4 14.6 43c-.3-6.4 5.2-9.4 8.2-14 2-3.2 1-7.4 1.2-11 .2-2.4 1-4.2 3-5Z" fill="#f2c230"/>
  <!-- print ridges -->
  <path d="M24 32c-2.6 4-4.4 8.4-4.6 13.4-.1 1.5 2.2 1.7 2.5.2.8-4.8 2.2-9 4.2-12.4.8-1.4-1.2-2.4-2.1-1.2Z" fill="currentColor" opacity="0.8"/>
  <path d="M40 33.6c2.2 3.6 3.6 7.6 3.8 12 .1 1.5-2.1 1.7-2.4.3-.7-4.2-1.9-7.9-3.5-11-.7-1.4 1.3-2.5 2.1-1.3Z" fill="currentColor" opacity="0.8"/>
  <!-- stem -->
  <path d="M29.6 12.6c-.6-2.4-.2-4.6 1.4-6.6 1.8 1.6 2.6 3.8 2.4 6.4-.1 1.6-3.4 1.8-3.8.2Z" fill="currentColor"/>
</svg>
