---
/* Linocut herb sprig (thyme-like). Single ink = currentColor. */
interface Props { size?: number; class?: string; }
const { size = 64, class: className = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className}>
  <!-- main stem, gentle curve -->
  <path d="M20 54C26 42 34 28 44 12c.8-1.3 2.8-.5 2.2 1C38 30 30 44 23 55.6c-.9 1.5-3.8.1-3-1.6Z" fill="currentColor"/>
  <!-- paired leaflets, hand-cut sizes -->
  <path d="M26 42c-4.4.6-8.6-.6-12-3.6 3.8-2.4 8.4-2.6 12.2-.6 1.4.8 1.2 4-.2 4.2Z" fill="currentColor"/>
  <path d="M30 35c1.2-4.2 4-7.6 8.2-9.4.6 4.4-1.2 8.6-4.8 11-1.3.9-3.8-.2-3.4-1.6Z" fill="currentColor"/>
  <path d="M32 30c-4 .4-7.8-.8-10.8-3.6 3.6-2 7.8-2 11.2-.2 1.3.7 1 3.6-.4 3.8Z" fill="currentColor"/>
  <path d="M36 23c1-3.8 3.6-6.8 7.2-8.4.6 4-1 7.8-4.2 10-1.2.8-3.4-.2-3-1.6Z" fill="currentColor"/>
  <path d="M38 18.6c-3.4.2-6.6-.8-9.2-3 3-1.8 6.6-1.8 9.6-.2 1.2.6.9 3.1-.4 3.2Z" fill="currentColor"/>
</svg>
