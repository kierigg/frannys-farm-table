---
/* Sticker badge system — Playful Farm Stand.
   Decorative inline-SVG badges copied from the brand board. */
type Variant =
  | 'made-fresh'
  | 'farm-to-table'
  | 'good-people'
  | 'seasonal'
  | 'honest'
  | 'support-local';

interface Props {
  variant: Variant;
  size?: number;
  rotation?: number;
  class?: string;
}

const OLIVE = '#3d4a26';
const SUNFLOWER = '#f2c230';
const TOMATO = '#dd4a2a';
const CREAM = '#f8f4e3';

/* Scalloped circle path: ~24 outward lobes */
function scallopPath(cx: number, cy: number, r: number, lobes = 24, depth = 1.12): string {
  const pts: [number, number][] = [];
  for (let i = 0; i < lobes; i++) {
    const a = (i / lobes) * Math.PI * 2 - Math.PI / 2;
    pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a)]);
  }
  const chord = 2 * r * Math.sin(Math.PI / lobes);
  const lr = ((chord / 2) * depth).toFixed(2);
  let d = `M ${pts[0][0].toFixed(2)} ${pts[0][1].toFixed(2)}`;
  for (let i = 1; i <= lobes; i++) {
    const [x, y] = pts[i % lobes];
    d += ` A ${lr} ${lr} 0 0 1 ${x.toFixed(2)} ${y.toFixed(2)}`;
  }
  return d + ' Z';
}

interface Config {
  shape: 'oval' | 'scallop' | 'pill' | 'rect';
  fill: string;
  text: string;
  stroke?: string;
  lines: string[];
  fontSize: number;
  rotation: number;
}

const configs: Record<Variant, Config> = {
  'made-fresh': {
    shape: 'oval', fill: OLIVE, text: SUNFLOWER,
    lines: ['MADE', 'FRESH', 'DAILY'], fontSize: 12, rotation: -2,
  },
  'farm-to-table': {
    shape: 'scallop', fill: SUNFLOWER, text: OLIVE,
    lines: ['FROM OUR', 'FARM TO', 'YOUR TABLE'], fontSize: 9.5, rotation: 2,
  },
  'good-people': {
    shape: 'pill', fill: CREAM, text: OLIVE, stroke: OLIVE,
    lines: ['GOOD', 'FOOD', 'GOOD', 'PEOPLE'], fontSize: 10, rotation: -1,
  },
  'seasonal': {
    shape: 'scallop', fill: TOMATO, text: CREAM,
    lines: ['SEASONAL', '&', 'LOCAL'], fontSize: 11, rotation: 3,
  },
  'honest': {
    shape: 'rect', fill: OLIVE, text: CREAM,
    lines: ['HONEST', 'INGREDIENTS', '\u00B7 REAL FOOD \u00B7'], fontSize: 9.5, rotation: 1,
  },
  'support-local': {
    shape: 'scallop', fill: SUNFLOWER, text: OLIVE,
    lines: ['SUPPORT', 'LOCAL', 'FARMS'], fontSize: 10.5, rotation: -3,
  },
};

const {
  variant,
  size = 120,
  rotation,
  class: className = '',
} = Astro.props as Props;

const c = configs[variant];
const rot = rotation ?? c.rotation;
const scallop = scallopPath(60, 60, 54);

/* Vertically center the line stack around y=60 */
const lineGap = c.fontSize * 1.35;
const startY = 60 - ((c.lines.length - 1) * lineGap) / 2;
const textY = (i: number) => (startY + i * lineGap).toFixed(2);
---
<svg
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={`badge ${className}`.trim()}
  style={`transform: rotate(${rot}deg);`}
>
  {c.shape === 'oval' && (
    <ellipse cx="60" cy="60" rx="57" ry="42" fill={c.fill} />
  )}
  {c.shape === 'scallop' && (
    <path d={scallop} fill={c.fill} />
  )}
  {c.shape === 'pill' && (
    <rect x="14" y="20" width="92" height="80" rx="20" fill={c.fill} stroke={c.stroke} stroke-width="2.5" />
  )}
  {c.shape === 'rect' && (
    <rect x="10" y="26" width="100" height="68" rx="8" fill={c.fill} />
  )}
  {c.lines.map((line, i) => (
    <text
      x="60"
      y={textY(i)}
      text-anchor="middle"
      dominant-baseline="middle"
      font-family="'Libre Franklin', sans-serif"
      font-size={c.fontSize}
      font-weight="700"
      letter-spacing="1.2"
      fill={c.text}
    >{line}</text>
  ))}
</svg>
