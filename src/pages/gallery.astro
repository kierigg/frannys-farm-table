---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';

const photos = [
  { label: 'Interior Dining Room', subject: 'Interior dining room, ground floor seating' },
  { label: 'Upstairs Seating', subject: 'Upstairs seating area overlooking Main Street' },
  { label: "Franny's Burger", subject: "Franny's Burger with fries" },
  { label: 'Loaded Mac & Cheese', subject: 'Loaded Mac & Cheese, guest favorite' },
  { label: 'Atlantic Salmon', subject: 'Atlantic Salmon with house-baked focaccia' },
  { label: 'Eggs Benedict (Brunch)', subject: 'Eggs Benedict, weekend brunch' },
  { label: 'Main Street Exterior', subject: 'Historic Main Street exterior, Placerville CA' },
  { label: 'Artisan Bread', subject: 'House-baked artisan bread, fresh daily' },
];
---

<Base
  title="Photos"
  description="Photos from inside Franny's Farm Table. Historic Main Street dining, house-made dishes, upstairs seating. Placerville, CA."
  slug="gallery"
  breadcrumb="Gallery"
>
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-label">Gallery</p>
      <h1 class="page-hero-title" transition:name="page-title">Inside Franny's</h1>
    </div>
  </div>

  <section class="section" aria-label="Photo gallery">
    <Reveal>
      <p class="section-body">
        Photos from Franny's Farm Table. See more on our
        <a href="https://instagram.com/frannysfarmtable" rel="noopener noreferrer" target="_blank" style="color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px;">Instagram</a>
        or
        <a href="https://yelp.com/biz/frannys-farm-table-placerville" rel="noopener noreferrer" target="_blank" style="color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px;">Yelp page</a>
        (272+ photos).
      </p>
    </Reveal>

    <div class="grid-gallery reveal-stagger">
      <div class="gallery-placeholder" role="img" aria-label="Interior dining room, ground floor seating">
        <span class="gallery-label">Interior Dining Room</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Upstairs seating area overlooking Main Street">
        <span class="gallery-label">Upstairs Seating</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Franny's Burger with fries">
        <span class="gallery-label">Franny's Burger</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Loaded Mac &amp; Cheese, guest favorite">
        <span class="gallery-label">Loaded Mac &amp; Cheese</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Atlantic Salmon with house-baked focaccia">
        <span class="gallery-label">Atlantic Salmon</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Eggs Benedict, weekend brunch">
        <span class="gallery-label">Eggs Benedict (Brunch)</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Historic Main Street exterior, Placerville CA">
        <span class="gallery-label">Main Street Exterior</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="House-baked artisan bread, fresh daily">
        <span class="gallery-label">Artisan Bread</span>
      </div>
      <div class="gallery-placeholder" role="img" aria-label="Franny's Burger close-up">
        <span class="gallery-label">Franny's Burger close-up</span>
      </div>
    </div>

    <p class="menu-footer-note" style="margin-top: 2rem;">
      All photos provided by the restaurant. Owner to upload final images.
    </p>
  </section>

  <!-- Instagram CTA band -->
  <div class="section--dark">
    <div class="section-inner" style="padding-top: 4rem; padding-bottom: 4rem; text-align: center;">
      <p class="instagram-cta-text">Want to see more? Follow us on Instagram.</p>
      <a href="https://instagram.com/frannysfarmtable" class="btn" rel="noopener noreferrer" target="_blank">
        Follow on Instagram
      </a>
    </div>
  </div>
</Base>
