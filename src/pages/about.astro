---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
---

<Base
  title="About"
  description="Opened 2023 on Historic Main Street in Placerville. Two floors, dog-friendly, wheelchair accessible. Weekend brunch Sat-Sun 9 AM to noon."
  slug="about"
  breadcrumb="About"
>
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-label">Our Story</p>
      <h1 class="page-hero-title" transition:name="page-title">Good food, made here, every day</h1>
    </div>
  </div>

  <!-- Light story section -->
  <section class="section" aria-label="About Franny's Farm Table">
    <div class="grid-2">
      <Reveal>
        <div>
          <p class="section-body" style="margin-bottom: 1.5rem;">
            Franny's Farm Table opened in 2023 in a historic building on Main Street in downtown Placerville. Our soups, dressings, sauces, and desserts are all made here from scratch — a rotating soup menu and seasonal cookies and baked goods keep things changing.
          </p>
          <p class="section-body" style="margin-bottom: 1.5rem;">
            The menu is big on purpose, with something for everyone, and we're happy to work with modifications. It's comfort food, done right — and to drink, local wine and craft beer from the El Dorado County wine region.
          </p>
          <p class="section-body" style="margin-bottom: 0;">
            Two floors. Ground-level dining room and an upstairs area that overlooks Main Street, seating about 50. Dog-friendly and wheelchair accessible. We take reservations, takeout, and delivery.
          </p>
        </div>
      </Reveal>

      <Reveal delay={100}>
        <div
          class="gallery-placeholder"
          role="img"
          aria-label="Interior of Franny's Farm Table dining room"
          style="min-height: 380px;"
        >
          <span class="gallery-label">Interior, Dining Room</span>
        </div>
      </Reveal>
    </div>
  </section>

  <div class="divider--accent" aria-hidden="true"></div>

  <!-- Dark feature cards -->
  <div class="section--dark">
    <div class="section-inner">
      <div class="grid-3 reveal-stagger">
        <div class="card card--dark">
          <h2 class="card-title card-title--light">Weekend Brunch</h2>
          <p class="card-body card-body--light">Saturdays and Sundays, 9 AM to noon. Eggs Benedict, breakfast tacos, crispy potatoes. Brunch here is just as good as dinner.</p>
        </div>
        <div class="card card--dark">
          <h2 class="card-title card-title--light">Local Wines &amp; Craft Beer</h2>
          <p class="card-body card-body--light">We carry local wines from the El Dorado County wine region, plus craft beers. The Mira Flores Cabernet is a guest favorite.</p>
        </div>
        <div class="card card--dark">
          <h2 class="card-title card-title--light">Gluten-Free Friendly</h2>
          <p class="card-body card-body--light">Gluten-free pasta, bread, and taco shells. Multiple guests have called our GF options some of the best they've found anywhere.</p>
        </div>
      </div>
    </div>
  </div>
</Base>
