    <div class="page-hero-inner">
      <p class="page-hero-label">Our Menu</p>
      <h1 class="page-hero-title" transition:name="page-title">Everything's made here</h1>
    </div>
  </div>

  <section class="section" aria-label="Full menu">
    <p class="menu-note">Everything's made here. Soups, breads, desserts, dressings — all in-house, daily.</p>
    <p class="menu-intro-line">From scratch, every day.</p>

    <div class="menu-filter-bar" role="group" aria-label="Filter menu by category" id="menu-filters">
      <button class="menu-filter-btn active" data-category="all">All</button>
      {categories.map(cat => (
        <button class="menu-filter-btn" data-category={cat.id}>{cat.label}</button>
      ))}
    </div>

    <div id="menu-categories">
      {categories.map(cat => (
        <div class="menu-category" data-category-id={cat.id}>
          <div class="menu-category-header">
            <h2 class="menu-category-title">{cat.label}</h2>
            {cat.note && <p class="menu-category-note">{cat.note}</p>}
          </div>

          {/* Standard items */}
          {cat.items.length > 0 && (
            <div>
              {cat.items.map(item => (
                <div class="menu-item">
                  <div class="menu-item-left">
                    <p class="menu-item-name">{item.name}</p>
                    {item.desc && <p class="menu-item-desc">{item.desc}</p>}
                  </div>
                  {item.price && <span class="menu-item-price">{item.price}</span>}
                </div>
              ))}
            </div>
          )}

          {/* Drinks subgroups */}
          {cat.subgroups && cat.subgroups.map(group => (
            <div class="menu-subgroup">
              <p class="menu-subgroup-label">{group.label}</p>
              {group.items.map(item => (
                <div class="menu-item">
                  <div class="menu-item-left">
                    <p class="menu-item-name">{item.name}</p>
                  </div>
                  <span class="menu-item-price">{item.price}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>

    <p class="menu-footer-note">
      Prices shown where available. Menu and pricing subject to change.
    </p>
  </section>
</Base>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.menu-filter-btn');
  const categories = document.querySelectorAll<HTMLElement>('.menu-category');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selected = btn.dataset.category;

      categories.forEach(cat => {
        if (selected === 'all' || cat.dataset.categoryId === selected) {
          cat.style.display = '';
        } else {
          cat.style.display = 'none';
        }
      });
    });
  });
</script>
